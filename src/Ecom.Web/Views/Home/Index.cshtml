@{
    ViewData["Title"] = "Trang chủ";
}

<!-- HERO -->
<section class="hero">
    <span class="sparkle" style="width:34px;height:34px;right:6%;top:12%"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.5c.7 3.9 2.4 6.7 7.5 9.5-5.1 2.8-6.8 5.6-7.5 9.5-.7-3.9-2.4-6.7-7.5-9.5 5.1-2.8 6.8-5.6 7.5-9.5Z" /></svg></span>
    <span class="sparkle" style="width:16px;height:16px;right:44%;top:10%;opacity:.7"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.5c.7 3.9 2.4 6.7 7.5 9.5-5.1 2.8-6.8 5.6-7.5 9.5-.7-3.9-2.4-6.7-7.5-9.5 5.1-2.8 6.8-5.6 7.5-9.5Z" /></svg></span>
    <span class="sparkle" style="width:22px;height:22px;left:46%;bottom:12%;opacity:.55"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.5c.7 3.9 2.4 6.7 7.5 9.5-5.1 2.8-6.8 5.6-7.5 9.5-.7-3.9-2.4-6.7-7.5-9.5 5.1-2.8 6.8-5.6 7.5-9.5Z" /></svg></span>
    <div class="row g-4 align-items-center position-relative">
        <div class="col-lg-6">
            <span class="eyebrow"><span class="star">✦</span> Oracle Database 23ai · JSON Relational Duality View</span>
            <h1>Mua sắm thông minh,<br />dữ liệu <span class="hl">một nguồn – hai cách nhìn</span></h1>
            <p class="lead">Shopia phục vụ ứng dụng bằng <b>tài liệu JSON</b> qua REST API và phục vụ báo cáo bằng
                <b>bảng quan hệ chuẩn hoá</b> – trên cùng một dữ liệu, không nhân bản, luôn nhất quán.</p>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a href="/Products" class="btn btn-gold btn-lg px-4">Khám phá sản phẩm</a>
                <a href="/Orders/Create" class="btn btn-light-glass btn-lg px-4">Tạo đơn ngay</a>
            </div>
            <div class="hero-stats">
                <div><b id="statProducts">–</b><span>sản phẩm</span></div>
                <div><b id="statOrders">–</b><span>đơn hàng</span></div>
                <div><b id="statCustomers">–</b><span>khách hàng</span></div>
                <div><b>3</b><span>Duality View</span></div>
            </div>
        </div>
        <div class="col-lg-6 d-none d-md-block">
            <div class="duality-art">
                <div class="panel json">
                    <div class="ph">{ } ORDER_DV · tài liệu JSON <span style="opacity:.6;font-weight:400">(minh hoạ)</span></div>
<pre>{ "_id": 60, "status": "PENDING",
  "customer": { "fullName": "…" },
  "items": [
    { "productId": 1, "quantity": 1,
      "unitPrice": 22990000 } ],
  "_metadata": { "etag": "B1F3…" } }</pre>
                </div>
                <div class="link" title="Cùng một dữ liệu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h13l-3.5-3.5M20 16H7l3.5 3.5" /></svg>
                </div>
                <div class="panel rel">
                    <div class="ph">▦ ORDERS · ORDER_ITEMS · bảng quan hệ</div>
                    <table>
                        <tr><th>ORDER_ID</th><th>STATUS</th><th>PRODUCT_ID</th><th>UNIT_PRICE</th></tr>
                        <tr><td>60</td><td>PENDING</td><td>1</td><td>22.990.000</td></tr>
                        <tr><td>59</td><td>SHIPPING</td><td>7</td><td>199.000</td></tr>
                        <tr><td>58</td><td>DELIVERED</td><td>12</td><td>1.290.000</td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- DẢI TÍNH NĂNG (đều là kỹ thuật thật của đồ án) -->
