<!-- Thông báo lỗi chung của trang chủ (kiểm tra kết nối chi tiết nằm ở trang Hệ thống – chỉ quản trị) -->
<div id="homeMsg"></div>

@section Scripts {
<script>
    const sel = id => document.getElementById(id);

    // Số liệu ở hero: GET /api/system/stats (công khai, chỉ 3 con số đếm)
    async function loadStats() {
        const { data } = await api('/api/system/stats');
        sel('statOrders').textContent = data.orders.toLocaleString('vi-VN');
        sel('statProducts').textContent = data.products.toLocaleString('vi-VN');
        sel('statCustomers').textContent = data.customers.toLocaleString('vi-VN');
    }
    loadStats().catch(err => showError('homeMsg', err));

    // ---------- Danh mục + sản phẩm đang bán (đọc tài liệu PRODUCT_DV) ----------
    async function loadShowcase() {
        const [{ data: facets }, { data: list }] = await Promise.all([
            api('/api/products/facets'), api('/api/products?activeOnly=true')]);
        sel('catGrid').innerHTML = facets.categories.map(c => {
            const look = categoryLook(c.name);
            return `<a class="cat-tile" href="/Products?categoryId=${c.id}">
                <div class="ph thumb c${look.c}">${icon(look.icon)}<img src="/img/categories/${c.id}.jpg" alt="" loading="lazy" onerror="this.remove()"></div>
                <b>${escapeHtml(c.name)}</b><span>${c.level > 1 ? 'Danh mục con' : 'Ngành hàng'}</span></a>`;
        }).join('');
        sel('featured').innerHTML = list.items.filter(p => p.stockQty > 0).slice(0, 10).map(p => productCard(p, { buy: roleKind() !== 'seller' })).join('')
            || '<div class="empty-state">Chưa có sản phẩm</div>';
    }
    loadShowcase().catch(err => showError('homeMsg', err));

    // ---------- M0: chọn vai trò ----------
    async function loadRoles() {
        // Khách: ô tìm phía server (không tải tất cả khách); người bán chỉ vài shop nên vẫn dùng dropdown
        const { data: ss } = await api('/api/sellers');
        sel('selSeller').innerHTML = ss.map(s =>
            `<option value="${s.id}">#${s.id} – ${escapeHtml(s.shopName)} (${s.products} SP)</option>`).join('');
        const r = getRole();
        sel('currentRole').textContent = r ? r.label : 'chưa chọn';
        await custPicker.set(r?.kind === 'customer' ? r.id : 1);
        if (r?.kind === 'seller') sel('selSeller').value = r.id;
    }
    // Chọn vai trò = đăng nhập mô phỏng: tìm khách qua /api/session/customers (chỉ mã + họ tên),
    // vì /api/customers (đầy đủ thông tin) chỉ dành cho quản trị
    const custPicker = customerPicker(sel('custPicker'), { allowClear: false, url: '/api/session/customers' });
    const pick = (raw, label, go) => { setRole(raw, label); location.href = go; };
    sel('btnCustomer').addEventListener('click', () => {
        if (!custPicker.value) return;
        pick(`customer:${custPicker.value}`, custPicker.text, '/Orders');
    });
    sel('btnSeller').addEventListener('click', () => {
        const o = sel('selSeller').selectedOptions[0];
        pick(`seller:${o.value}`, o.text, '/Products');
    });
    sel('btnAdmin').addEventListener('click', () => pick('admin', 'Quản trị sàn', '/Orders'));
    sel('btnClearRole').addEventListener('click', () => { clearRole(); location.reload(); });
    loadRoles().catch(err => showError('homeMsg', err));
</script>
}
