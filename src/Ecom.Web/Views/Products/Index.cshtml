@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="page-head">
    <div>
        <div class="crumbs"><a href="/">Trang chủ</a> / Sản phẩm</div>
        <h1>Sản phẩm</h1>
    </div>
    <button id="btnNew" class="btn btn-outline-success">+ Thêm sản phẩm bằng tài liệu JSON</button>
</div>
<div class="tech-note">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5" /><path d="M12 11v5.5M12 7.8v.2" /></svg>
    <div>Lọc chạy trên bảng <code>products</code> bằng SQL/JSON (<code>JSON_VALUE</code>, <code>JSON_EXISTS</code>);
        mỗi thẻ là một tài liệu đọc thẳng từ Duality View <code>PRODUCT_DV</code>. Bấm <b>JSON</b> để xem / sửa tài liệu (kèm ETag).</div>
</div>

<div class="row g-4">
    <!-- BỘ LỌC -->
    <div class="col-lg-3">
        <form id="filterForm" class="card filter-card">
            <div class="card-header card-title-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16l-6 7.5V19l-4 1.5v-8L4 5Z" /></svg>Bộ lọc
            </div>
            <div class="card-body">
                <div id="sellerFilter"></div>
                <label class="form-label">Danh mục</label>
                <select name="categoryId" class="form-select form-select-sm mb-2"></select>

                <label class="form-label" title="Lọc theo JSON_VALUE(attributes, '$.brand')">Thương hiệu</label>
                <select name="brand" class="form-select form-select-sm mb-2"></select>

                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label" title="Lọc theo JSON_VALUE(attributes, '$.ramGb' RETURNING NUMBER)">RAM tối thiểu</label>
                        <select name="minRamGb" class="form-select form-select-sm mb-2">
                            <option value="">Bất kỳ</option><option value="6">6 GB</option><option value="8">8 GB</option><option value="12">12 GB</option><option value="16">16 GB</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label" title="Lọc theo JSON_VALUE(attributes, '$.storageGb' RETURNING NUMBER)">Bộ nhớ tối thiểu</label>
                        <select name="minStorageGb" class="form-select form-select-sm mb-2">
                            <option value="">Bất kỳ</option><option value="128">128 GB</option><option value="256">256 GB</option><option value="512">512 GB</option>
                        </select>
                    </div>
                </div>

                <label class="form-label" title="Lọc theo JSON_EXISTS(attributes, '$.size[*]?(@@ == $s)')">Kích cỡ (size)</label>
                <select name="size" class="form-select form-select-sm mb-2">
                    <option value="">Bất kỳ</option>
                    <option>S</option><option>M</option><option>L</option><option>XL</option><option>30</option><option>32</option>
                </select>

                <label class="form-label">Tên chứa</label>
                <input name="q" class="form-control form-control-sm mb-2" placeholder="ví dụ: iPhone" />

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="activeOnly" value="true" id="activeOnly">
                    <label class="form-check-label" for="activeOnly">Chỉ sản phẩm đang bán</label>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-primary flex-fill" type="submit">Lọc</button>
                    <button class="btn btn-sm btn-outline-secondary" type="reset">Xoá lọc</button>
                </div>

                <hr />
                <div class="fw-semibold mb-1">Thuộc tính JSON có trong danh mục</div>
                <div class="text-muted small mb-2">Hệ thống tự nhận biết từ dữ liệu (JSON_DATAGUIDE)</div>
                <div id="attrKeys"></div>
            </div>
        </form>
    </div>

    <!-- DANH SÁCH -->
    <div class="col-lg-9">
        <div id="listMsg"></div>
        <div class="toolbar">
            <span>Tìm thấy <b id="count">0</b> sản phẩm</span>
            <details class="small">
                <summary>Câu SQL lọc vừa chạy</summary>
            </details>
        </div>
        <pre id="filterSql" class="bg-light mb-3" hidden></pre>
        <div id="productRows" class="product-grid"></div>
    </div>
</div>

<!-- HỘP THOẠI XEM / SỬA TÀI LIỆU JSON -->
<div class="modal fade" id="docModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="docTitle">Tài liệu PRODUCT_DV</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="small mb-2">
                    ETag đang giữ: <code id="docEtag">—</code>
                    <span class="text-muted ms-2">(gửi kèm header <code>If-Match</code> khi lưu)</span>
                </div>
                <div id="docMsg"></div>
                <textarea id="docText" class="form-control font-monospace small" rows="20" spellcheck="false"></textarea>
                <div class="form-text">
                    Thử TH-5: mở cùng sản phẩm ở hai tab, lưu ở tab 1, rồi lưu ở tab 2 → tab 2 nhận <b>412</b>.
                    Thử TH-6/TC-11: xoá <code>"brand"</code> trong <code>attributes</code> rồi lưu → bị JSON Schema từ chối (422).
                    Các trường <code>seller.shopName</code>, <code>category.categoryName</code> chỉ đọc.
                </div>
            </div>
            <div class="modal-footer">
                <button id="btnReload" class="btn btn-outline-secondary">Tải lại (GET)</button>
                <button id="btnSave" class="btn btn-primary">Lưu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/products.js" asp-append-version="true"></script>
}
