@{
    ViewData["Title"] = "Chi tiết đơn";
    var orderId = (long)ViewData["OrderId"]!;
}

<div class="page-head mb-2">
    <div class="crumbs"><a href="/">Trang chủ</a> / <a href="/Orders">Đơn hàng</a> / Chi tiết đơn #@orderId</div>
</div>
<div class="order-hero">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
        <div>
            <h1>Đơn <span id="hdrOrderNo" class="mono">#@orderId</span> <span id="hdrStatus"></span></h1>
            <div id="hdrMeta" class="small text-muted mt-1"></div>
        </div>
        <form class="d-flex gap-1" onsubmit="location.href='/Orders/Details/' + this.id.value; return false;">
            <input name="id" type="number" min="1" class="form-control form-control-sm" style="width:110px" placeholder="ID đơn" />
            <button class="btn btn-sm btn-outline-secondary">Mở</button>
            <button type="button" id="btnRefresh" class="btn btn-sm btn-primary">Đọc lại cả hai</button>
        </form>
    </div>
    <div id="orderStepper"></div>
</div>

<div id="msg"></div>

<!-- ===================== M5 – XỬ LÝ ĐƠN ===================== -->
<div class="card mb-3">
    <div class="card-header d-flex flex-wrap justify-content-between gap-2">
        <span class="card-title-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M12 3.5v2.2M12 18.3v2.2M3.5 12h2.2M18.3 12h2.2M6 6l1.6 1.6M16.4 16.4 18 18M6 18l1.6-1.6M16.4 7.6 18 6" /></svg><span><b>Xử lý đơn</b> <span class="text-muted small" data-roles="seller,admin">— kết quả hiện ngay ở cả hai tab bên dưới</span></span></span>
        <span class="small" data-roles="seller,admin">ETag đang giữ: <code id="etagHeld">—</code></span>
    </div>
    <div class="card-body small">
        <div id="actionMsg"></div>
        <div class="row g-3">
            <!-- Đổi trạng thái / huỷ: đường quan hệ (PKG_ORDER) -->
            <div class="col-lg-6"><div class="action-block">
                <div class="fw-semibold">1. Trạng thái <span class="text-muted" data-roles="seller,admin">(POST → pkg_order.sp_change_status / sp_cancel_order)</span></div>
                <div class="text-muted mb-1" data-roles="seller,admin">Trạng thái kế tiếp hợp lệ do hàm <code>fn_is_valid_transition</code> trong CSDL tính:</div>
                <div class="text-muted mb-1" data-roles="customer">Bạn có thể huỷ đơn khi đơn chưa được giao cho đơn vị vận chuyển:</div>
                <div id="nextButtons" class="d-flex flex-wrap gap-1 mb-2"></div>
                <div class="input-group input-group-sm mb-1">
                    <span class="input-group-text">Ghi chú</span>
                    <input id="statusNote" class="form-control" placeholder="lý do / ghi chú (lưu vào lịch sử)" />
                </div>
                <div class="input-group input-group-sm" data-roles="seller,admin">
                    <span class="input-group-text">Thử chuyển tới</span>
                    <select id="anyStatus" class="form-select">
                        <option>PENDING</option><option>CONFIRMED</option><option>PACKING</option><option>SHIPPING</option>
                        <option>DELIVERED</option><option>CANCELLED</option><option>RETURNED</option>
                    </select>
                    <button id="btnAnyStatus" class="btn btn-outline-danger">Gửi (kể cả sai)</button>
                </div>
                <div class="form-text" data-roles="seller,admin">Dùng để demo TC-05: chuyển sai sơ đồ → CSDL từ chối (ORA-20002).</div>
            </div></div>

            <!-- Thanh toán: chọn kênh -->
            <div class="col-lg-6" data-roles="customer,admin"><div class="action-block">
                <div class="fw-semibold">2. Ghi thanh toán</div>
                <div class="row g-1 mb-1">
                    <div class="col-4"><select id="payMethod" class="form-select form-select-sm">
                        <option>COD</option><option>BANK_TRANSFER</option><option>E_WALLET</option><option>CARD</option></select></div>
                    <div class="col-4"><input id="payAmount" type="number" min="1" class="form-control form-control-sm" /></div>
                    <div class="col-4"><input id="payRef" class="form-control form-control-sm" placeholder="Mã giao dịch" /></div>
                </div>
                <div class="d-flex gap-3 mb-1" data-roles="admin">
                    <div class="form-check"><input class="form-check-input" type="radio" name="payChannel" id="payProc" value="proc" checked>
                        <label class="form-check-label" for="payProc">Qua procedure <code>sp_record_payment</code></label></div>
                    <div class="form-check"><input class="form-check-input" type="radio" name="payChannel" id="payJson" value="json">
                        <label class="form-check-label" for="payJson">Qua tài liệu: thêm vào <code>payments[]</code> (PUT)</label></div>
                </div>
                <button id="btnPay" class="btn btn-sm btn-success">Ghi thanh toán</button>
                <span class="text-muted ms-2">Đã trả: <b id="paidSoFar">0</b> / <b id="totalAmt">0</b></span>
                <div class="form-text" data-roles="admin">TC-08: nhập số tiền lớn hơn phần còn lại → bị chặn ở <b>cả hai kênh</b> (ORA-20005).</div>
            </div></div>

            <!-- Sửa đơn bằng tài liệu JSON -->
            <div class="col-lg-8" data-roles="customer,admin"><div class="action-block">
                <div class="fw-semibold">3. Sửa đơn <span data-roles="seller,admin">bằng tài liệu JSON <span class="text-muted">(PUT /api/orders/{id} + If-Match → UPDATE order_dv)</span></span><span class="text-muted" data-roles="customer">(địa chỉ giao, sản phẩm khi đơn còn chờ xác nhận)</span></div>
                <div class="row g-1 mb-1">
                    <div class="col-sm-4"><input id="edReceiver" class="form-control form-control-sm" placeholder="Người nhận" /></div>
                    <div class="col-sm-3"><input id="edPhone" class="form-control form-control-sm" placeholder="Điện thoại" /></div>
                    <div class="col-sm-5"><input id="edAddress" class="form-control form-control-sm" placeholder="Địa chỉ" /></div>
                    <div class="col-sm-3" data-roles="admin"><div class="input-group input-group-sm"><span class="input-group-text">Ship</span><input id="edFee" type="number" min="0" class="form-control" /></div></div>
                    <div class="col-sm-3" data-roles="admin"><div class="input-group input-group-sm"><span class="input-group-text">Giảm</span><input id="edDiscount" type="number" min="0" class="form-control" /></div></div>
                </div>
                <table class="table table-sm mb-1">
                    <thead><tr><th>Sản phẩm</th><th style="width:90px">SL</th><th></th></tr></thead>
                    <tbody id="edItems"></tbody>
                </table>
                <div class="input-group input-group-sm mb-1" style="max-width:360px">
                    <span class="input-group-text">Thêm SP id</span>
                    <input id="edNewPid" type="number" min="1" class="form-control" />
                    <span class="input-group-text">SL</span>
                    <input id="edNewQty" type="number" min="1" value="1" class="form-control" />
                    <button id="btnEdAdd" class="btn btn-outline-secondary">+</button>
                </div>
                <button id="btnSaveDoc" class="btn btn-sm btn-primary">Lưu thay đổi</button>
                <div class="form-text" data-roles="admin">
                    Dòng hàng chỉ sửa được khi đơn <b>PENDING</b> (đã khoá → 409 ORA-20004, TC-06).
                    TC-09: mở đơn này ở <b>hai tab</b>, lưu ở tab 1 rồi lưu ở tab 2 → tab 2 nhận <b>412</b>.
                </div>
            </div></div>

            <!-- Vận đơn -->
            <div class="col-lg-4" data-roles="seller,admin"><div class="action-block">
                <div class="fw-semibold">4. Thêm vận đơn <span class="text-muted">(thêm vào shipments[], PUT)</span></div>
                <select id="shipCarrier" class="form-select form-select-sm mb-1">
                    <option>GHN</option><option>GHTK</option><option>Viettel Post</option><option>Ninja Van</option></select>
                <input id="shipTracking" class="form-control form-control-sm mb-1" placeholder="Mã vận đơn" />
                <button id="btnShip" class="btn btn-sm btn-outline-primary">Thêm vận đơn</button>
            </div></div>
        </div>
    </div>
</div>

<ul class="nav nav-tabs" role="tablist">
    <li class="nav-item" data-roles="customer,seller"><button class="nav-link" id="tabSummaryBtn" data-bs-toggle="tab" data-bs-target="#tabSummary" type="button">Thông tin đơn hàng</button></li>
    <li class="nav-item" data-roles="admin"><button class="nav-link active" id="tabJsonBtn" data-bs-toggle="tab" data-bs-target="#tabJson" type="button">Dạng JSON (ORDER_DV)</button></li>
    <li class="nav-item" data-roles="admin"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabRel" type="button">Dạng bảng quan hệ (5 bảng)</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabTime" type="button">Theo thời gian</button></li>
</ul>
<div class="tab-content border border-top-0 p-3 mb-3">
    <div class="tab-pane fade" id="tabSummary"><div id="orderSummary"></div></div>
    <div class="tab-pane fade show active" id="tabJson">
        <div class="small mb-2">
            ETag: <code id="etag">—</code>
            <span class="text-muted ms-2">asof (SCN lúc đọc): <code id="asof">—</code></span>
        </div>
        <div class="row g-3">
            <div class="col-lg-7">
                <pre id="jsonDoc" class="bg-light small mb-0" style="max-height:640px; overflow:auto"></pre>
            </div>
            <div class="col-lg-5 small">
                <div class="fw-semibold mb-1">Trường JSON ↔ cột / bảng nền</div>
                <table class="table table-sm table-bordered">
                    <thead class="table-light"><tr><th>Trường JSON</th><th>Bảng.cột</th><th>Ghi qua JSON?</th></tr></thead>
                    <tbody>
                        <tr><td>_id</td><td>orders.order_id</td><td>khoá</td></tr>
                        <tr><td>orderNo, orderDate</td><td>orders.order_no, order_date</td><td>NOUPDATE (trigger sinh)</td></tr>
                        <tr><td>status</td><td>orders.status</td><td>NOUPDATE: chỉ đổi qua sp_change_status</td></tr>
                        <tr><td>ship*, shippingFee, discount</td><td>orders.ship_*, shipping_fee, discount_amount</td><td>có</td></tr>
                        <tr><td>subtotal, totalAmount</td><td>orders.subtotal, total_amount</td><td>NOUPDATE (trigger tính)</td></tr>
                        <tr><td>customer{}</td><td>customers</td><td>chỉ đọc; fullName/email NOCHECK</td></tr>
                        <tr><td>items[]</td><td>order_items</td><td>thêm/sửa/xoá khi PENDING</td></tr>
                        <tr><td>items[].productId, sku, productName</td><td>products (UNNEST)</td><td>chỉ đọc</td></tr>
                        <tr><td>items[].unitPrice</td><td>order_items.unit_price</td><td>NOUPDATE (trigger chốt giá)</td></tr>
                        <tr><td>payments[]</td><td>payments</td><td>thêm/sửa, không xoá</td></tr>
                        <tr><td>shipments[]</td><td>shipments</td><td>thêm/sửa, không xoá</td></tr>
                        <tr><td>history[]</td><td>order_status_history</td><td>chỉ đọc (trigger ghi)</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="tab-pane fade" id="tabRel">
        <div id="relTables"></div>
    </div>
    <div class="tab-pane fade" id="tabTime">
        <p class="small text-muted mb-2" data-roles="customer">Xem lại đơn hàng như lúc bạn mở trang hoặc vài phút trước; các mục đã thay đổi được tô vàng.</p>
        <p class="small text-muted mb-2" data-roles="seller,admin">
            Đọc lại <b>cả tài liệu đơn</b> như nó đã là tại một thời điểm trước (Flashback Query:
            <code>SELECT … FROM order_dv AS OF SCN n</code>). Oracle dựng lại tài liệu từ dữ liệu cũ (undo) của 5 bảng nền,
            không cần bảng lịch sử riêng. Giữ được tối thiểu 15 phút, không quay về được trước lần reset dữ liệu.
        </p>
        <div class="d-flex flex-wrap gap-2 align-items-center mb-2 small">
            <button class="btn btn-sm btn-primary" id="ttOpen">Lúc mở trang</button>
            <button class="btn btn-sm btn-outline-secondary" data-minutes="1">1 phút trước</button>
            <button class="btn btn-sm btn-outline-secondary" data-minutes="5">5 phút trước</button>
            <button class="btn btn-sm btn-outline-secondary" data-minutes="15">15 phút trước</button>
            <form id="ttForm" data-roles="seller,admin" class="input-group input-group-sm" style="max-width:260px">
                <span class="input-group-text">SCN</span>
                <input id="ttScn" class="form-control" inputmode="numeric" placeholder="ví dụ 26205207" />
                <button class="btn btn-outline-primary">Xem</button>
            </form>
        </div>
        <div id="ttMsg"></div>
        <div id="ttResult"></div>
    </div>
</div>

@section Scripts {
    <script>const ORDER_ID = @orderId;</script>
    <script src="~/js/orders-details.js" asp-append-version="true"></script>
    <script src="~/js/orders-timetravel.js" asp-append-version="true"></script>
}
