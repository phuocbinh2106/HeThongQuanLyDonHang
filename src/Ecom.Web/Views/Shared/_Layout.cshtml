@{
    // Đánh dấu mục menu đang mở
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var act = ViewContext.RouteData.Values["action"]?.ToString();
    // Vai trò hiện tại (cookie ecom_user đã kiểm tra) -> chỉ hiện menu mà vai trò này được phép dùng.
    // Đây chỉ là phần hiển thị; quyền thật được kiểm tra lại ở API và ở từng trang (RequireRole).
    var role = Context.Role();
    bool canOrder = role.Kind is RoleKind.Customer or RoleKind.Admin;                          // tạo đơn
    bool canSeeOrders = role.Kind is RoleKind.Customer or RoleKind.Seller or RoleKind.Admin;   // danh sách đơn
    bool canCustomers = role.Kind is RoleKind.Customer or RoleKind.Admin;                      // hồ sơ / khách hàng
    bool canSell = role.Kind is RoleKind.Seller or RoleKind.Admin;                             // đăng bán sản phẩm
    bool canReports = role.Kind == RoleKind.Admin;                                             // báo cáo
    string Active(string c, string? a = null) =>
        string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) && (a == null || string.Equals(act, a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Shopia</title>
    <meta name="description" content="Shopia – sàn thương mại điện tử minh hoạ JSON Relational Duality View (Oracle Database 23ai)" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon-32.png" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Thanh trên cùng: lối vào kênh người bán / quản trị + công nghệ của đồ án -->
    <div class="sp-topbar">
        <div class="container">
            <div>
                <a href="/#roles">Kênh người bán</a><span class="sep">|</span>
                <a href="/#roles">Quản trị sàn</a><span class="sep">|</span>
                <a href="/#th">6 tình huống Duality View</a><span class="sep">|</span>
                <a href="/api-docs" target="_blank" rel="noopener">API Docs (Swagger)</a>
            </div>
            <div class="tech">
                <span class="star">✦</span> Oracle Database 23ai · JSON Relational Duality View · ASP.NET Core MVC
            </div>
        </div>
    </div>

    <!-- Header: logo + tìm kiếm + lối tắt -->
    <header class="sp-header">
        <div class="container">
            <a class="sp-logo" asp-controller="Home" asp-action="Index" title="Shopia – Trang chủ">
                <img src="~/img/shopia-logo.png" alt="Shopia" width="134" height="46" />
            </a>
            <form class="sp-search" action="/Products" method="get" role="search">
                <input name="q" placeholder="Tìm sản phẩm, thương hiệu… (ví dụ: iPhone, Samsung, áo thun)" aria-label="Tìm sản phẩm"
                       value="@(string.Equals(ctrl, "Products", StringComparison.OrdinalIgnoreCase) ? Context.Request.Query["q"].ToString() : "")" />
                <button type="submit">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6" /></svg>
                    <span class="d-none d-md-inline">Tìm</span>
                </button>
            </form>
            <div class="sp-actions">
                @if (canSeeOrders)
                {
                <a class="sp-action" asp-controller="Orders" asp-action="Index" title="Đơn hàng">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="17" rx="2" /><path d="M9 4.5h6V7H9z" /><path d="M8.5 11h7M8.5 14.5h7M8.5 18h4" /></svg>
                    <span>Đơn hàng</span>
                </a>
                }
                @if (canOrder)
                {
                <a class="sp-action" asp-controller="Orders" asp-action="Create" title="Giỏ hàng / Tạo đơn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2.2l2.1 10.2a1.5 1.5 0 0 0 1.5 1.2h8.4a1.5 1.5 0 0 0 1.5-1.1L20.5 8H6.2" /><circle cx="9.5" cy="19.5" r="1.4" /><circle cx="17" cy="19.5" r="1.4" /></svg>
                    <span>Giỏ hàng</span>
                </a>
                }
                <!-- vai trò hiện tại (api.js điền nội dung từ cookie ecom_user) -->
                <a href="/#roles" id="roleBadge" class="sp-role" title="Đổi vai trò ở trang chủ"></a>
            </div>
        </div>
    </header>

    <nav class="sp-nav" aria-label="Menu chính">
        <div class="container">
            <a class="@Active("Home")" asp-controller="Home" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5 12 4l9 7.5" /><path d="M5.5 10v9.5h13V10" /><path d="M10 19.5v-5h4v5" /></svg>Trang chủ</a>
            <a class="@Active("Products", "Index")" asp-controller="Products" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1.2 12H6.2L5 8Z" /><path d="M9 8V6.5a3 3 0 0 1 6 0V8" /></svg>Sản phẩm</a>
            @if (canSell)
            {
            <a class="@Active("Products", "Create")" asp-controller="Products" asp-action="Create">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="3" /><path d="M12 8.5v7M8.5 12h7" /></svg>Đăng bán</a>
            }
            @if (canSell)
            {
            <a class="@Active("Seller")" asp-controller="Seller" asp-action="Stats">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19h16" /><path d="m5 15 4-4 3 3 6-6" /><path d="M15 8h3v3" /></svg>Thống kê shop</a>
            }
            @if (canOrder)
            {
            <a class="@Active("Orders", "Create")" asp-controller="Orders" asp-action="Create">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2.2l2.1 10.2a1.5 1.5 0 0 0 1.5 1.2h8.4a1.5 1.5 0 0 0 1.5-1.1L20.5 8H6.2" /><circle cx="9.5" cy="19.5" r="1.4" /><circle cx="17" cy="19.5" r="1.4" /></svg>Tạo đơn</a>
            }
            @if (canSeeOrders)
            {
            <a class="@(Active("Orders", "Index") + Active("Orders", "Details"))" asp-controller="Orders" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="17" rx="2" /><path d="M9 4.5h6V7H9z" /><path d="M8.5 11h7M8.5 14.5h7M8.5 18h4" /></svg>@(role.Kind == RoleKind.Customer ? "Đơn của tôi" : role.Kind == RoleKind.Seller ? "Đơn của shop" : "Đơn hàng")</a>
            }
            @if (canReports)
            {
            <a class="@Active("Reports")" asp-controller="Reports" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16" /><rect x="5.5" y="11" width="3" height="7" rx=".8" /><rect x="10.5" y="6" width="3" height="12" rx=".8" /><rect x="15.5" y="13.5" width="3" height="4.5" rx=".8" /></svg>Báo cáo</a>
            }
            @if (canCustomers)
            {
            <a class="@Active("Customers")" asp-controller="Customers" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8.5" r="3.2" /><path d="M3.5 19.5c.6-3.2 2.8-5 5.5-5s4.9 1.8 5.5 5" /><circle cx="16.8" cy="9.5" r="2.5" /><path d="M15.8 14.6c2.4-.2 4.3 1.4 4.8 4.4" /></svg>@(role.Kind == RoleKind.Customer ? "Hồ sơ của tôi" : "Khách hàng")</a>
            }
            @if (canReports)
            {
            <a class="@Active("System")" asp-controller="System" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="6" rx="7" ry="2.8" /><path d="M5 6v12c0 1.5 3.1 2.8 7 2.8s7-1.3 7-2.8V6" /><path d="M5 12c0 1.5 3.1 2.8 7 2.8s7-1.3 7-2.8" /></svg>Hệ thống</a>
            }
            @if (canReports)
            {
            <a class="@Active("Ords")" asp-controller="Ords" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h11M4 12h16M4 17h9" /><path d="m17 5 3 2-3 2M15 15l3 2-3 2" /></svg>C# và ORDS</a>
            }
            @if (canReports)
            {
            <a class="@Active("Demo")" asp-controller="Demo" asp-action="Concurrency">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="8" r="2.5" /><circle cx="17" cy="8" r="2.5" /><path d="M3 19c.5-3 2-4.5 4-4.5s3.5 1.5 4 4.5M13 19c.5-3 2-4.5 4-4.5s3.5 1.5 4 4.5" /></svg>Mua đồng thời</a>
            }
        </div>
    </nav>

    <main role="main" class="container sp-main">
        @RenderBody()
    </main>

    <footer class="sp-footer">
        <div class="container top">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="brand">
                        <img src="~/img/shopia-icon.png" alt="" width="44" height="44" />
                        <b>Shop<span>ia</span></b>
                    </div>
                    <p class="mb-2">Sàn thương mại điện tử đa người bán – ứng dụng minh hoạ cho đồ án
                        <b>Hệ thống quản lý đơn hàng</b> trên Oracle Database 23ai.</p>
                    <div>
                        <span class="chip">JSON Relational Duality View</span><span class="chip">PL/SQL</span>
                        <span class="chip">ETag</span><span class="chip">REST API</span>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Mua sắm</h6>
                    <ul>
                        <li><a href="/Products">Sản phẩm</a></li>
                        <li data-roles="customer,admin"><a href="/Orders/Create">Tạo đơn</a></li>
                        <li data-roles="customer,seller,admin"><a href="/Orders">Đơn hàng</a></li>
                        <li data-roles="customer,admin"><a href="/Customers">Sổ địa chỉ</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-3">
                    <h6>Kỹ thuật</h6>
                    <ul>
                        <li><a href="/#th">6 tình huống khó (TH-1…TH-6)</a></li>
                        <li data-roles="admin"><a href="/Reports">Báo cáo SQL (PKG_ORDER_RPT)</a></li>
                        <li><a href="/api-docs" target="_blank" rel="noopener">Tài liệu REST API (Swagger)</a></li>
                        <li data-roles="admin"><a href="/System">Kiểm tra kết nối Oracle</a></li>
                        <li><a href="https://github.com/phuocbinh2106/HeThongQuanLyDonHang" target="_blank" rel="noopener">Mã nguồn trên GitHub</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h6>Nhóm thực hiện</h6>
                    <ul>
                        <li>Tống Phước Bình – 24DH110200</li>
                        <li>Nguyễn Thị Khánh Uyên – 24DH112109</li>
                        <li>Hoàng Hồng Minh Anh – 24DH112475</li>
                        <li class="mt-1">GVHD: ThS. Lê Hồng Thúy Vũ</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="container bottom">
            <span>© 2026 Shopia · Đồ án môn Các hệ quản trị cơ sở dữ liệu – HUFLIT</span>
            <span>Oracle Database 23ai (Docker) · ASP.NET Core MVC · ODP.NET</span>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/api.js" asp-append-version="true"></script>
    <script src="~/js/shopia.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
